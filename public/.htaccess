Options -Indexes
DirectoryIndex index.php

AddType application/javascript .js .mjs
AddType image/svg+xml .svg
AddDefaultCharset UTF-8

# Browsers revalidate assets on every load (cheap 304s), so updates are
# picked up immediately — ES modules can't carry a version query string.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|svg)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/csv
</IfModule>

# Block dotfiles (except .well-known for SSL validation).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>
